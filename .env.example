# ============================================================================
# HR Document Generator — configuration. Copy to `.env` and fill in.
# ============================================================================

SECRET_KEY=change-this-to-a-long-random-string
PAGE_SIZE=A4                      # A4 or Letter

# --- The 4 authorised users (comma separated). Only these may sign in. ------
AUTHORIZED_EMAILS=user1@fouressynergy.com,user2@fouressynergy.com,user3@fouressynergy.com,user4@fouressynergy.com

# --- Authentication ---------------------------------------------------------
# AUTH_MODE = zoho  (recommended)  |  password  (quick local/dev use)
AUTH_MODE=password

# password mode: shared password for the allow-listed users
LOCAL_PASSWORD=change-me-strong

# zoho mode: register an app at https://api-console.zoho.com (Server-based app).
# Add the redirect URI below to the app. Use the accounts base for your DC
# (.com, .eu, .in, .com.au, .jp).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:5000/auth/callback
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com

# --- Transactional email (management notification on every PDF download) ----
EMAIL_ENABLED=false               # set true once SMTP creds are filled in
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=hr@fouressynergy.com
SMTP_PASSWORD=your-zoho-app-specific-password
MAIL_FROM=hr@fouressynergy.com
MAIL_FROM_NAME=HR Document Generator
MANAGEMENT_EMAILS=management1@fouressynergy.com,management2@fouressynergy.com

# --- Storage ----------------------------------------------------------------
DB_PATH=data/hrdocs.db
